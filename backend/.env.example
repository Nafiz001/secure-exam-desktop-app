# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local PostgreSQL)
# For local development, install PostgreSQL and create 'invigilo_db' database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invigilo_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Alternative: Supabase Configuration (Shared Team Database)
# Uncomment and use these values if using Supabase
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_supabase_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=24h

# Groq AI (powers the Teacher Dashboard's AI Assistant — chat + question generation)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
