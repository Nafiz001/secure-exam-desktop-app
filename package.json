{
  "name": "secure-exam-desktop-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "install:backend": "npm --prefix backend install --omit=dev",
    "start": "npm run build:renderer && electron .",
    "dev:renderer": "vite --config renderer/vite.config.mjs",
    "build:renderer": "vite build --config renderer/vite.config.mjs",
    "start:react": "npm run start",
    "pack:win": "npm run build:renderer && npm run install:backend && electron-builder --win nsis portable --config.win.signAndEditExecutable=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nafiz001/secure-exam-desktop-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Nafiz001/secure-exam-desktop-app/issues"
  },
  "homepage": "https://github.com/Nafiz001/secure-exam-desktop-app#readme",
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "ps-list": "^9.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0"
  },
  "build": {
    "appId": "com.nafiz.secureexamdesktop",
    "productName": "Secure Exam Desktop",
    "asar": true,
    "afterPack": "scripts/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "renderer/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "node_modules/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": true
    }
  }
}
